{
  "name": "dr-anudeep-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:preview": "node scripts/build.cjs --preview",
    "dev": "node scripts/build.cjs --preview --serve",
    "test": "node --test tests/*.test.cjs && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.7",
    "gray-matter": "4.0.3",
    "markdown-it": "14.3.3"
  }
}
